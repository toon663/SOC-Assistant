{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Analyst alert for Prognostic Agent",
  "type": "object",
  "required": ["schema_version", "alert_id", "analyst_revision", "timestamp", "anomaly_score", "triage_score", "analyst_confidence", "verdict", "entities", "normalized_events", "observed_techniques"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "request_id": {"type": ["string", "null"], "minLength": 1},
    "alert_id": {"type": "string", "minLength": 1},
    "analyst_revision": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "anomaly_score": {"type": "number", "minimum": 0, "maximum": 100},
    "triage_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100, "description": "Behavioral score excluding asset impact. Null means unavailable; never substitute the Analyst total."},
    "behavioral_score_source": {"enum": ["unknown", "supplied"]},
    "analyst_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "verdict": {"enum": ["benign", "suspicious", "malicious"]},
    "user_id": {"type": ["string", "null"]},
    "host_id": {"type": ["string", "null"]},
    "source_ip": {"type": ["string", "null"]},
    "entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "normalized_events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "observed_techniques": {"type": "array", "items": {"$ref": "#/$defs/technique"}},
    "correlated_alert_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "findings": {"type": "array", "items": {"type": "string"}},
    "guard_context": {"$ref": "guard_context.schema.json"}
  },
  "$defs": {
    "entity": {
      "type": "object", "required": ["entity_id", "entity_type"],
      "properties": {"entity_id": {"type": "string", "minLength": 1}, "entity_type": {"enum": ["user", "host", "service"]}}
    },
    "event": {
      "type": "object", "required": ["event_id", "event_type", "timestamp"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1}, "event_type": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string", "format": "date-time"},
        "entity_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "technique": {
      "type": "object", "required": ["technique_id"],
      "properties": {
        "technique_id": {"type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"},
        "attribution": {"enum": ["exact", "coarse"], "default": "exact"},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      },
      "allOf": [{"if": {"required": ["attribution"], "properties": {"attribution": {"const": "coarse"}}}, "then": {"properties": {"evidence_refs": {"maxItems": 0}}}}]
    }
  },
  "$comment": "Runtime validation additionally checks reference resolution, unique event/entity/technique identities, nonblank strings, and finite JSON numbers. Empty evidence arrays lead to abstention."
}
