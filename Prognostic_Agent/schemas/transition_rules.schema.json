{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prognostic transition-rule document, versions 1 and 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "rules"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1, 2]},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}}
  },
  "allOf": [{
    "if": {"properties": {"schema_version": {"const": 1}}},
    "then": {"properties": {"rules": {"items": {
      "not": {"anyOf": [{"required": ["guards"]}, {"required": ["terminal"]}]}
    }}}}
  }],
  "$defs": {
    "technique": {"type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"},
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "source", "target", "target_name", "platform", "minimum_privilege", "requires_reachable_target", "rationale", "references"],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/technique"},
        "target": {"$ref": "#/$defs/technique"},
        "target_name": {"type": "string", "minLength": 1},
        "platform": {"enum": ["windows", "linux", "macos"]},
        "minimum_privilege": {"enum": ["none", "user", "admin", "system"]},
        "requires_reachable_target": {"type": "boolean"},
        "include_subtechniques": {"type": "boolean"},
        "excluded_subtechniques": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/technique"}},
        "rationale": {"type": "string", "minLength": 1},
        "references": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "terminal": {"type": "boolean", "description": "Stop expansion after this admitted transition; grants no permission by itself."},
        "guards": {
          "type": "array", "uniqueItems": true,
          "description": "Version 2 only. Runtime enforces unique guard types and evaluates only supplied evidence-bound assertions. Missing/unknown/stale facts are unresolved; contradicted facts fail. No evidence discovery or score generation.",
          "items": {"oneOf": [
            {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"const": "exact_attribution"}}},
            {"type": "object", "additionalProperties": false, "required": ["type", "max_age_hours"], "properties": {"type": {"const": "evidence_freshness"}, "max_age_hours": {"type": "number", "exclusiveMinimum": 0}}},
            {"type": "object", "additionalProperties": false, "required": ["type", "minimum_events", "window_hours"], "properties": {"type": {"const": "analyst_correlation"}, "minimum_events": {"type": "integer", "minimum": 1}, "window_hours": {"type": "number", "exclusiveMinimum": 0}}},
            {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"const": "authentication_reachability"}}},
            {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"const": "account_authentication"}}},
            {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"const": "target_not_observed"}}}
          ]}
        }
      }
    }
  }
}
