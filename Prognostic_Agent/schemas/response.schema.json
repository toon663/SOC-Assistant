{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prognostic Agent response envelopes",
  "required": ["schema_version", "agent_version", "config_version", "versions", "provenance_issues", "environment", "behavioral_score_source", "risk_score_may_include_asset_impact"],
  "properties": {
    "environment": {"enum": ["test", "demo", "production"]},
    "behavioral_score_source": {"enum": ["unknown", "supplied"]},
    "risk_score_may_include_asset_impact": {"type": ["boolean", "null"]},
    "agent_version": {"type": "string"}, "config_version": {"type": "string"},
    "versions": {"$ref": "#/$defs/versions"}, "provenance_issues": {"type": "array"}
  },
  "oneOf": [
    {"$ref": "#/$defs/forecast"},
    {"$ref": "#/$defs/validation_error"},
    {"$ref": "#/$defs/operational_error"},
    {"type": "object", "required": ["response_type"], "properties": {"response_type": {"enum": ["purge_result", "history_result", "shadow_report", "unsupported_report", "batch_replay_result", "synthetic_contrast_result"]}}}
  ],
  "$defs": {
    "versions": {
      "type": "object", "required": ["agent", "config", "config_hash", "rules", "rules_hash", "weights", "weights_hash"],
      "properties": {
        "agent": {"type": "string"}, "config": {"type": "string"}, "config_hash": {"type": ["string", "null"]},
        "rules": {"type": ["string", "null"]}, "rules_hash": {"type": ["string", "null"]},
        "weights": {"type": ["string", "null"]}, "weights_hash": {"type": ["string", "null"]}
      }
    },
    "validation_error": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "response_type", "request_id", "alert_id", "errors"],
      "properties": {
        "environment": {"enum": ["test", "demo", "production"]},
        "behavioral_score_source": {"enum": ["unknown", "supplied"]},
        "risk_score_may_include_asset_impact": {"type": ["boolean", "null"]},
        "agent_version": {"type": "string"}, "config_version": {"type": "string"},
        "versions": {"$ref": "#/$defs/versions"}, "provenance_issues": {"type": "array"}, "diagnostics": {"type": "object"},
        "schema_version": {"const": 1}, "response_type": {"const": "validation_error"},
        "request_id": {"type": ["string", "null"]}, "alert_id": {"type": ["string", "null"]},
        "errors": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["field", "code", "message"],
          "properties": {"field": {"type": "string"}, "code": {"type": "string"}, "message": {"type": "string"}}
        }}
      }
    },
    "operational_error": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "response_type", "reason", "reason_detail"],
      "properties": {
        "schema_version": {"const": 1}, "response_type": {"const": "operational_error"}, "reason": {"type": "string"}, "reason_detail": {"type": "string"},
        "environment": {"enum": ["test", "demo", "production"]},
        "behavioral_score_source": {"enum": ["unknown", "supplied"]},
        "risk_score_may_include_asset_impact": {"type": ["boolean", "null"]},
        "agent_version": {"type": "string"}, "config_version": {"type": "string"},
        "versions": {"$ref": "#/$defs/versions"}, "provenance_issues": {"type": "array"}, "diagnostics": {"type": "object"},
        "computed_result": {"type": "object"}, "persisted": {"type": "boolean"}
      }
    },
    "forecast": {
      "type": "object",
      "required": ["schema_version", "response_type", "alert_id", "analyst_revision", "input_fingerprint", "forecast_as_of", "generated_at", "status", "reason", "reason_detail", "numeric_assessment_status", "explanation_status", "risk_score", "predicted_path", "candidate_paths", "likelihood", "time_horizon", "confidence", "blast_radius", "asset_context", "evidence_references", "unsupported_starting_techniques", "versions", "issues"],
      "properties": {
        "schema_version": {"const": 1}, "response_type": {"const": "risk_forecast"},
        "alert_id": {"type": "string"}, "analyst_revision": {"type": "string"},
        "input_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "forecast_as_of": {"type": "string", "format": "date-time"}, "generated_at": {"type": "string", "format": "date-time"},
        "status": {"enum": ["complete", "partial", "abstained"]},
        "reason": {"type": "string", "minLength": 1}, "reason_detail": {"type": "string", "minLength": 1},
        "numeric_assessment_status": {"enum": ["complete", "partial", "unavailable"]},
        "explanation_status": {"enum": ["deterministic", "llm_selected", "unavailable"]},
        "risk_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "predicted_path": {"type": ["object", "null"]}, "candidate_paths": {"type": "array", "items": {"type": "object"}},
        "likelihood": {"type": ["object", "null"]},
        "time_horizon": {"type": "object"}, "confidence": {"type": "object"}, "blast_radius": {"type": "object"},
        "asset_context": {"type": "object"}, "evidence_references": {"type": "array"},
        "unsupported_starting_techniques": {"type": "array"}, "versions": {"type": "object"}, "issues": {"type": "array"}
      },
      "allOf": [{
        "if": {"properties": {"status": {"const": "abstained"}}},
        "then": {"properties": {"predicted_path": {"type": "null"}, "likelihood": {"type": "null"}}}
      }]
    }
  }
}
